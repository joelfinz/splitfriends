# Runtime (read by docker compose)
RP_ID=split.example.com                 # WebAuthn relying party id = your public hostname
ORIGIN=https://split.example.com        # public origin, used in invite links and passkey checks
PUSH_CONTACT=mailto:you@example.com     # VAPID contact sent to push services
APP_NAME=Fairshare
BIND_ADDR=127.0.0.1                     # host interface to bind; keep loopback behind a proxy/tunnel
BIND_PORT=8080                          # host port

# deploy.sh (optional)
DEPLOY_HOST=my-server                   # ssh host alias
DEPLOY_DIR=Projects/splitfriends        # path relative to the remote $HOME
